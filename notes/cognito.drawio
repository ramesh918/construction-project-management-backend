<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-07-31" version="15.0" type="device">
  <diagram id="cognito" name="Cognito Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- TITLE -->
        <mxCell id="title" value="AWS COGNITO - AUTHENTICATION AND AUTHORIZATION FLOW" style="text;html=1;fontSize=22;fontStyle=bold;align=center;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1700" height="60" as="geometry"/>
        </mxCell>

        <!-- SECTION 1 -->
        <mxCell id="sec1" value="PART 1: CORE CONCEPTS" style="text;html=1;fontSize=16;fontStyle=bold;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="1700" height="35" as="geometry"/>
        </mxCell>

        <!-- BOX 1: USER POOL -->
        <mxCell id="b1" value="USER POOL&#xA;(buildtrack-users)&#xA;&#xA;Central Authentication Service&#xA;&#xA;Stores user credentials&#xA;Manages user accounts&#xA;Enforces password policies&#xA;Manages user groups&#xA;Generates JWT tokens" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#B3E5FC;strokeColor=#0277BD;strokeWidth=2;align=left;verticalAlign=top;padding=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="150" width="400" height="200" as="geometry"/>
        </mxCell>

        <!-- BOX 2: APP CLIENT -->
        <mxCell id="b2" value="APP CLIENT&#xA;(buildtrack-app-client)&#xA;&#xA;Bridge Between App and Pool&#xA;&#xA;Your app uses to login&#xA;No client secret (public)&#xA;Enables auth flows&#xA;Manages token validity&#xA;Email-based login" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#C8E6C9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;padding=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="150" width="400" height="200" as="geometry"/>
        </mxCell>

        <!-- BOX 3: USER GROUPS -->
        <mxCell id="b3" value="USER GROUPS&#xA;Authorization Levels&#xA;&#xA;ADMIN GROUP&#xA;Precedence: 1&#xA;Full system access&#xA;Manage users&#xA;&#xA;USER GROUP&#xA;Precedence: 2&#xA;Limited access" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFE0B2;strokeColor=#F57C00;strokeWidth=2;align=left;verticalAlign=top;padding=12;" vertex="1" parent="1">
          <mxGeometry x="950" y="150" width="400" height="200" as="geometry"/>
        </mxCell>

        <!-- BOX 4: ACCESS CONTROL -->
        <mxCell id="b4" value="ACCESS CONTROL&#xA;Authorization Check&#xA;&#xA;Backend verifies token&#xA;Extracts user group&#xA;Compares with route&#xA;&#xA;Responses:&#xA;200 OK - Granted&#xA;403 Forbidden - Denied" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F8BBD0;strokeColor=#C2185B;strokeWidth=2;align=left;verticalAlign=top;padding=12;" vertex="1" parent="1">
          <mxGeometry x="1400" y="150" width="350" height="200" as="geometry"/>
        </mxCell>

        <!-- SECTION 2 -->
        <mxCell id="sec2" value="PART 2: USER CREATION AND LOGIN FLOW" style="text;html=1;fontSize=16;fontStyle=bold;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="375" width="1700" height="35" as="geometry"/>
        </mxCell>

        <!-- STEP 1: CREATE USER -->
        <mxCell id="s1t" value="STEP 1: Admin Creates User" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=bold;fillColor=#FFEB3B;strokeColor=#F57F17;strokeWidth=2;padding=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="430" width="430" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="s1d" value="Admin opens Cognito Console&#xA;Clicks Manage Users&#xA;Creates new user&#xA;Enters email: john@example.com&#xA;System sends temporary password" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFDE7;strokeColor=#F57F17;padding=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="485" width="430" height="100" as="geometry"/>
        </mxCell>

        <!-- ARROW -->
        <mxCell id="a1" value="" style="endArrow=classic;html=1;strokeWidth=3;" edge="1" parent="1" source="s1d" target="s2t">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- STEP 2: ASSIGN GROUP -->
        <mxCell id="s2t" value="STEP 2: Admin Assigns Group" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=bold;fillColor=#4CAF50;strokeColor=#1B5E20;strokeWidth=2;padding=8;color:#ffffff;" vertex="1" parent="1">
          <mxGeometry x="530" y="430" width="430" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="s2d" value="Admin finds created user&#xA;Clicks on Groups&#xA;Selects: admin OR user&#xA;Attaches group to user&#xA;Saves configuration" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E8F5E9;strokeColor=#1B5E20;padding=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="530" y="485" width="430" height="100" as="geometry"/>
        </mxCell>

        <!-- ARROW -->
        <mxCell id="a2" value="" style="endArrow=classic;html=1;strokeWidth=3;" edge="1" parent="1" source="s2d" target="s3t">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- STEP 3: USER READY -->
        <mxCell id="s3t" value="STEP 3: User Ready to Login" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=bold;fillColor=#2196F3;strokeColor=#0D47A1;strokeWidth=2;padding=8;color:#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1010" y="430" width="430" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="s3d" value="User Profile Created&#xA;Email: john@example.com&#xA;Status: FORCE_CHANGE_PASSWORD&#xA;Group: admin&#xA;Ready to login" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E3F2FD;strokeColor=#0D47A1;padding=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1010" y="485" width="430" height="100" as="geometry"/>
        </mxCell>

        <!-- SECTION 3 -->
        <mxCell id="sec3" value="PART 3: LOGIN AND AUTHENTICATION (6 STEPS)" style="text;html=1;fontSize=16;fontStyle=bold;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="620" width="1700" height="35" as="geometry"/>
        </mxCell>

        <!-- LOGIN STEP 1 -->
        <mxCell id="l1t" value="1. User Enters Email + Password" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=bold;fillColor=#FF9800;strokeColor=#E65100;strokeWidth=2;color:#ffffff;padding=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="675" width="270" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="l1d" value="Frontend App&#xA;Email: john@ex.com&#xA;Password: Pass123" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF3E0;strokeColor=#E65100;padding=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="730" width="270" height="80" as="geometry"/>
        </mxCell>

        <!-- LOGIN STEP 2 -->
        <mxCell id="l2t" value="2. Send to Cognito" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=bold;fillColor=#2196F3;strokeColor=#0D47A1;strokeWidth=2;color:#ffffff;padding=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="675" width="270" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="l2d" value="HTTPS POST Request&#xA;To: /oauth2/token&#xA;Body: email, password" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor:#E3F2FD;strokeColor=#0D47A1;padding=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="340" y="730" width="270" height="80" as="geometry"/>
        </mxCell>

        <!-- LOGIN STEP 3 -->
        <mxCell id="l3t" value="3. Cognito Verifies" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=bold;fillColor=#9C27B0;strokeColor:#4A148C;strokeWidth=2;color:#ffffff;padding=8;" vertex="1" parent="1">
          <mxGeometry x="630" y="675" width="270" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="l3d" value="Cognito checks:&#xA;Find user by email&#xA;Verify password&#xA;Get user groups" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F3E5F5;strokeColor=#4A148C;padding=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="630" y="730" width="270" height="80" as="geometry"/>
        </mxCell>

        <!-- LOGIN STEP 4 -->
        <mxCell id="l4t" value="4. Generate Tokens" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=bold;fillColor=#4CAF50;strokeColor=#1B5E20;strokeWidth=2;color:#ffffff;padding=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="675" width="270" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="l4d" value="Create JWT tokens:&#xA;accessToken (1 hour)&#xA;idToken (1 hour)&#xA;refreshToken (30 days)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E8F5E9;strokeColor=#1B5E20;padding=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="920" y="730" width="270" height="80" as="geometry"/>
        </mxCell>

        <!-- LOGIN STEP 5 -->
        <mxCell id="l5t" value="5. Return Tokens" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=bold;fillColor=#00BCD4;strokeColor=#006064;strokeWidth=2;color:#ffffff;padding=8;" vertex="1" parent="1">
          <mxGeometry x="1210" y="675" width="270" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="l5d" value="Response 200 OK&#xA;access_token: jwt&#xA;refresh_token: jwt&#xA;expires_in: 3600" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E0F2F1;strokeColor=#006064;padding=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1210" y="730" width="270" height="80" as="geometry"/>
        </mxCell>

        <!-- LOGIN STEP 6 -->
        <mxCell id="l6t" value="6. Store Tokens" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=bold;fillColor=#673AB7;strokeColor=#311B92;strokeWidth=2;color:#ffffff;padding=8;" vertex="1" parent="1">
          <mxGeometry x="1500" y="675" width="250" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="l6d" value="Frontend stores:&#xA;localStorage&#xA;accessToken&#xA;User LOGGED IN" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F3E5F5;strokeColor=#311B92;padding=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1500" y="730" width="250" height="80" as="geometry"/>
        </mxCell>

        <!-- SECTION 4 -->
        <mxCell id="sec4" value="PART 4: API CALL WITH AUTHORIZATION" style="text;html=1;fontSize=16;fontStyle=bold;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="835" width="1700" height="35" as="geometry"/>
        </mxCell>

        <!-- API BOX -->
        <mxCell id="api" value="API CALL AUTHORIZATION FLOW&#xA;&#xA;Step 1: Frontend sends API request with accessToken in header&#xA;Step 2: Backend extracts token from Authorization header&#xA;Step 3: Backend verifies token signature and expiry&#xA;Step 4: Backend decodes token to get user info and groups&#xA;Step 5: Backend checks if user group matches route requirement&#xA;&#xA;IF user group = admin AND route requires admin:&#xA;Result: 200 OK - Access GRANTED, return data&#xA;&#xA;IF user group = user AND route requires admin:&#xA;Result: 403 Forbidden - Access DENIED, return error" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFDE7;strokeColor:#F57F17;strokeWidth=2;align=left;verticalAlign=top;padding=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="890" width="1700" height="200" as="geometry"/>
        </mxCell>

        <!-- SECTION 5 -->
        <mxCell id="sec5" value="PART 5: TOKEN REFRESH AND EXPIRY" style="text;html=1;fontSize=16;fontStyle=bold;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="1115" width="1700" height="35" as="geometry"/>
        </mxCell>

        <!-- REFRESH BOX -->
        <mxCell id="refresh" value="TOKEN REFRESH MECHANISM&#xA;&#xA;Timeline:&#xA;T=0 hours: User logs in, gets accessToken (expires in 1 hour)&#xA;T=1 hour: accessToken EXPIRES, backend returns 401 error&#xA;T=1 hour: Frontend detects 401, sends refreshToken to Cognito&#xA;&#xA;Cognito validates refreshToken (valid for 30 days)&#xA;Cognito generates NEW accessToken (valid 1 more hour)&#xA;Cognito generates NEW idToken (valid 1 more hour)&#xA;Returns same refreshToken (not rotated)&#xA;&#xA;Frontend stores new accessToken&#xA;User continues without re-entering password&#xA;User stays logged in for 30 days total" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;padding=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="1170" width="1700" height="220" as="geometry"/>
        </mxCell>

        <!-- SECTION 6 -->
        <mxCell id="sec6" value="PART 6: ERROR CODES" style="text;html=1;fontSize=16;fontStyle=bold;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="1420" width="1700" height="35" as="geometry"/>
        </mxCell>

        <!-- ERRORS BOX -->
        <mxCell id="errors" value="COMMON ERROR CODES&#xA;&#xA;401 Unauthorized: Wrong password OR token expired OR no token provided&#xA;403 Forbidden: User logged in but lacks permission for this route&#xA;400 User Not Found: Email not registered in User Pool&#xA;400 Invalid Token: Token tampered with or from different pool&#xA;429 Too Many Requests: Too many login attempts in short time" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;padding=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="1475" width="1700" height="150" as="geometry"/>
        </mxCell>

        <!-- SECTION 7 -->
        <mxCell id="sec7" value="PART 7: COMPLETE FLOW SUMMARY" style="text;html=1;fontSize=16;fontStyle=bold;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="1660" width="1700" height="35" as="geometry"/>
        </mxCell>

        <!-- SUMMARY BOX -->
        <mxCell id="summary" value="KEY CONCEPTS AND COMPLETE FLOW&#xA;&#xA;USER POOL: Cloud service stores users, passwords, groups. Generates JWT tokens for authentication.&#xA;APP CLIENT: Your app configuration to connect to User Pool using ClientID.&#xA;ACCESS TOKEN: Short-lived JWT (1 hour) proving authentication. Sent with every API request.&#xA;REFRESH TOKEN: Long-lived JWT (30 days) gets new access tokens without re-entering password.&#xA;USER GROUPS: Collections of users (admin, user) that control what they can access.&#xA;&#xA;END-TO-END FLOW:&#xA;1. Admin creates user in Cognito 2. Admin assigns user to group 3. User enters email and password 4. Frontend sends to Cognito&#xA;5. Cognito verifies credentials 6. Cognito returns JWT tokens 7. Frontend stores tokens 8. Frontend sends accessToken with API calls&#xA;9. Backend verifies token and checks user group 10. Backend grants (200) or denies (403) access 11. When accessToken expires, use refreshToken to get new one&#xA;12. User stays logged in for 30 days without re-entering password" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E3F2FD;strokeColor=#0277BD;strokeWidth=2;align=left;verticalAlign=top;padding=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="1715" width="1700" height="200" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
