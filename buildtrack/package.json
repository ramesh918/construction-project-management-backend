{
  "name": "buildtrack",
  "version": "1.0.0",
  "scripts": {
    "build":        "tsc --noEmit",
    "build:watch":  "tsc --noEmit --watch",
    "synth":        "cdk synth",
    "deploy":       "cdk deploy",
    "deploy:dev":   "CDK_ENV=dev cdk deploy",
    "deploy:prod":  "CDK_ENV=prod cdk deploy",
    "diff":         "cdk diff",
    "destroy":      "cdk destroy"
  },
  "devDependencies": {
    "aws-cdk":                            "^2.0.0",
    "aws-cdk-lib":                        "^2.0.0",
    "constructs":                         "^10.0.0",
    "typescript":                         "^5.0.0",
    "@types/node":                        "^20.0.0",
    "ts-node":                            "^10.0.0",
    "jest":                               "^29.0.0",
    "@types/jest":                        "^29.0.0",
    "ts-jest":                            "^29.0.0",
    "eslint":                             "^8.0.0",
    "@typescript-eslint/eslint-plugin":   "^6.0.0",
    "@typescript-eslint/parser":          "^6.0.0",
    "prettier":                           "^3.0.0"
  }
}